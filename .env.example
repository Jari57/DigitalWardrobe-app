DATABASE_URL="postgresql://user:password@localhost:5432/wardrobe?schema=public"
APP_URL="http://localhost:3000"
AI_ENABLED="false"
# Integer millionths of USD. Leave zero until the owner approves a budget and provider pricing is verified.
AI_DAILY_CAP_MICROS="0"
AI_MAX_REQUEST_MICROS="0"
NEXT_PUBLIC_FITSTALKER_TRY_ON_ENABLED="false"
# Approved per-render upper bound in USD micros. Must fit within AI_MAX_REQUEST_MICROS.
FITSTALKER_TRY_ON_MAX_COST_MICROS="0"
# Optional HTTPS operations webhook. Sends aggregate failure/budget signals only.
OPS_ALERT_WEBHOOK=
